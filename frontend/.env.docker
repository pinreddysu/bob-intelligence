# Docker runtime environment variables for the frontend container.
#
# BACKEND_HOST — host:port of the backend service that nginx will proxy
# /api/* requests to. Use the docker-compose service name when running
# via compose (default: backend:8000). Override here if needed.
#
# Do NOT set VITE_API_BASE_URL here — API calls are routed through
# the nginx /api/ proxy block, not a hardcoded browser-side URL.
BACKEND_HOST=backend:8000
