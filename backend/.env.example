# Bob Intelligence — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use in-memory SQLite (default for MVP).
# Set to a file path (e.g. sqlite:///./bob_intelligence.db) to persist across
# restarts, or a PostgreSQL URL for production.
DATABASE_URL=

# ── Jira ──────────────────────────────────────────────────────────────────────
# Required for live Jira story import. Leave blank to use sample data.
# JIRA_BASE_URL must be the Atlassian Cloud base URL, e.g.:
#   https://yourorg.atlassian.net
JIRA_BASE_URL=
JIRA_USER_EMAIL=
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Jira custom field keys — verify by calling:
#   GET /rest/api/3/issue/{key}?expand=names
# on a known story and inspecting the returned field names.
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_AC_FIELD=

# ── GitHub (M4b — PR enrichment) ──────────────────────────────────────────────
# Personal access token with repo read scope.
# For PUBLIC repositories, GITHUB_TOKEN is optional — unauthenticated requests
# are allowed but subject to a lower rate limit (60 req/hour vs 5000).
# For PRIVATE repositories, GITHUB_TOKEN is required.
# When absent on a private repo, PR enrichment is skipped and source_warning is recorded.
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (read-only is sufficient for public repos; full repo for private).
GITHUB_TOKEN=

# ── LLM provider ──────────────────────────────────────────────────────────────
# When LLM_API_KEY is absent, mode recommendation defaults to "collaborative"
# and uncertainty_note is explicitly labelled as NOT evidence-based.
#
# Supported providers:
#   bob       — IBM Bob headless CLI (recommended); invoked as a subprocess.
#               Requires 'bob' on PATH and BOBSHELL_API_KEY set via LLM_API_KEY.
#               LLM_ENDPOINT and LLM_MODEL are not used for this provider.
#   openai    — OpenAI chat completions API
#   watsonx   — IBM watsonx.ai text generation API
#
LLM_PROVIDER=bob
LLM_API_KEY=<api_key_for_bob>
BOB_API_KEY=<api_key_for_bob>


# API endpoint — not used for LLM_PROVIDER=bob.
# openai:  default is https://api.openai.com (leave blank for default)
# watsonx: REQUIRED — set to your watsonx.ai inference endpoint, e.g.:
#          https://us-south.ml.cloud.ibm.com
LLM_ENDPOINT=

# Model identifier — not used for LLM_PROVIDER=bob.
#   openai:  default is gpt-4o-mini
#   watsonx: default is ibm/granite-13b-chat-v2
LLM_MODEL=

# IBM watsonx project ID (required for watsonx provider only)
LLM_PROJECT_ID=

# ── PIE repository (for git evidence capture) ─────────────────────────────────
# Absolute path to the local PIE repository clone.
# Required only for commit-SHA-based diff capture in Milestone 4.
# Unverified until Milestone 4c is implemented and tested.
PIE_REPO_PATH=

# Optional: path to a pytest JSON output file from PIE
PIE_TEST_RESULT_PATH=
