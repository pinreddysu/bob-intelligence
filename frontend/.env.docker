# Docker build-time environment variables for the frontend.
# Copy this file, fill in values, and pass it to the build:
#
#   docker build --build-arg VITE_API_BASE_URL \
#                --secret id=env,src=.env.docker \
#                ...
#
# Or with docker-compose (see compose.yml), set values here and they are
# picked up automatically via the `args:` block in the build section.
#
# Do NOT commit real secrets here — this file is for non-sensitive build config.
# Empty — frontend uses relative /api/* paths; nginx proxies them to the backend.
VITE_API_BASE_URL=
