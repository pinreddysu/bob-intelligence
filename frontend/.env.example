# Bob Intelligence — Frontend environment variables
#
# Copy this file to .env.local and set VITE_API_BASE_URL if the backend
# is not served on the same origin. Leave blank to use the Vite dev proxy.
#
# In development (npm run dev), Vite proxies /api/* to http://localhost:8000
# by default, so VITE_API_BASE_URL is not needed.
#
# In production, set this to your backend origin (no trailing slash):
#   VITE_API_BASE_URL=https://api.example.com
#
# Do NOT embed API tokens, secrets, or passwords here.
VITE_API_BASE_URL=
